{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchArtifact",
  "description": "Traceable hand-off record exchanged by research swarm members.",
  "type": "object",
  "required": ["id", "kind", "producer", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["literature", "citation", "method", "experiment", "result", "review"]},
    "producer": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "claim": {"type": "string"},
    "summary": {"type": "string"},
    "doi": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "path": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "parents": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"enum": ["literature", "citation"]}}}, "then": {"anyOf": [{"required": ["doi"]}, {"required": ["url"]}, {"required": ["path"]}]}},
    {"if": {"properties": {"kind": {"enum": ["experiment", "result"]}}}, "then": {"required": ["path"]}}
  ],
  "additionalProperties": false
}
